class Handler(BaseHTTPRequestHandler):
    def reply(self, code, payload):
        body = (json.dumps(payload) + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def reply_html(self, page):
        body = page.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def reply_logo(self):
        name = os.path.basename(self.path)
        if not re.fullmatch(r"[a-z0-9_-]+\.png", name):
            return self.reply(404, {"error": "not found"})
        try:
            with open(os.path.join(LOGO_DIR, name), "rb") as f:
                body = f.read()
        except OSError:
            return self.reply(404, {"error": "not found"})
        self.send_response(200)
        self.send_header("Content-Type", "image/png")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "max-age=86400")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        config = load_config()
        if self.path == "/":
            self.reply_html(GUI_PAGE)
        elif self.path.startswith("/logos/"):
            self.reply_logo()
        elif self.path == "/mixer":
            self.reply_html(MIXER_PAGE)
        elif self.path == "/mixer.json":
            self.reply(200, mixer_state(config))
        elif self.path == "/status":
            self.reply(200, status(config))
        elif self.path == "/channels":
            self.reply(200, {"channels": [{"id": cid, "name": ch["name"]}
                                          for cid, ch in config["channels"].items()],
                             "default": config["default_channel"]})
        elif self.path == "/outputs":
            self.reply(200, {"outputs": [{"id": oid, "name": o["name"]}
                                         for oid, o in sorted(config["outputs"].items())],
                             "default": config["default_output"]})
        else:
            self.reply(404, {"error": "not found"})

    def body_json(self):
        length = int(self.headers.get("Content-Length") or 0)
        if not length:
            return {}
        return json.loads(self.rfile.read(length))

    def body_field(self, field):
        return self.body_json().get(field)

    def do_POST(self):
        config = load_config()
        if self.path in ("/play", "/select"):
            try:
                channel = self.body_field("channel")
                if self.path == "/play":
                    play(config, channel)
                else:
                    select(config, channel or current_channel(config))
            except ValueError as e:
                return self.reply(400, {"error": str(e)})
            self.reply(200, status(config))
        elif self.path == "/output":
            try:
                set_output(config, self.body_field("output") or current_output(config))
            except ValueError as e:
                return self.reply(400, {"error": str(e)})
            self.reply(200, status(config))
        elif self.path == "/volume":
            try:
                body = self.body_json()
                set_volume(body.get("type"), body.get("id"), body.get("volume"))
            except ValueError as e:
                return self.reply(400, {"error": str(e)})
            self.reply(200, {"ok": True})
        elif self.path == "/stop":
            stop()
            self.reply(200, status(config))
        else:
            self.reply(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args), flush=True)


def main():
    config = load_config()
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "play":
        channel = sys.argv[2] if len(sys.argv) > 2 else None
        play(config, channel)
        print("playing %s" % current_channel(config))
    elif cmd == "stop":
        stop()
        print("stopped")
    elif cmd == "status":
        s = status(config)
        print("%s (%s)" % ("playing" if s["playing"] else "stopped", s["channel"]))
    elif cmd == "channels":
        for cid, ch in config["channels"].items():
            print("%s\t%s" % (cid, ch["name"]))
    elif cmd == "output":
        if len(sys.argv) > 2:
            set_output(config, sys.argv[2])
        print(current_output(config))
    elif cmd == "outputs":
        for oid, o in sorted(config["outputs"].items()):
            print("%s\t%s" % (oid, o["name"]))
    elif cmd == "serve":
        ThreadingHTTPServer(("0.0.0.0", int(config["port"])), Handler).serve_forever()
    elif cmd == "_run":
        run_player(config)
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except ValueError as e:
        print("error: %s" % e, file=sys.stderr)
        sys.exit(1)
