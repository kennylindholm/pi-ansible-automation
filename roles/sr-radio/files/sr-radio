#!/usr/bin/env python3
"""Play Sveriges Radio live streams on the audiopi.

CLI:
  sr-radio play [CHANNEL]   start playback (default channel if omitted)
  sr-radio stop             stop playback
  sr-radio status           show playback state and channel
  sr-radio channels         list available channels
  sr-radio output [OUTPUT]  show or set audio output
  sr-radio outputs          list available outputs

HTTP API (run by sr-radio-api.service):
  GET  /                    web GUI
  GET  /mixer               volume mixer GUI
  GET  /mixer.json          {"sinks": [{"id", "name", "volume"}], "streams": [...]}
  POST /volume              body {"type": "sink"|"stream", "id": ..., "volume": 0-100}
  GET  /status              {"playing": bool, "channel": str, "output": str}
  GET  /channels            {"channels": [{"id": str, "name": str}], "default": str}
  GET  /outputs             {"outputs": [{"id": str, "name": str}], "default": str}
  POST /play                body {"channel": "p3"}, optional (default: current channel)
  POST /select              switch channel without starting playback; if already
                            playing, switches immediately
  POST /output              body {"output": "aux"}; applies immediately if playing
  POST /stop

Internal:
  sr-radio serve            run the HTTP API
  sr-radio _run             exec mpv for the current channel (used by sr-radio.service)
"""
import json
import os
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONFIG_FILE = os.environ.get("SR_RADIO_CONFIG", "/opt/sr-radio/config.json")
STATE_FILE = os.environ.get("SR_RADIO_STATE", "/opt/sr-radio/current")
OUTPUT_FILE = os.environ.get("SR_RADIO_OUTPUT", "/opt/sr-radio/output")
LOGO_DIR = os.environ.get("SR_RADIO_LOGOS", "/opt/sr-radio/logos")


def load_config():
    with open(CONFIG_FILE) as f:
        return json.load(f)


def read_state(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except FileNotFoundError:
        return ""


def current_channel(config):
    channel = read_state(STATE_FILE)
    return channel if channel in config["channels"] else config["default_channel"]


def current_output(config):
    output = read_state(OUTPUT_FILE)
    return output if output in config["outputs"] else config["default_output"]


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], check=False).returncode


def is_playing():
    return systemctl("is-active", "--quiet", "sr-radio") == 0


def set_channel(config, channel):
    if channel not in config["channels"]:
        raise ValueError("unknown channel: %s (available: %s)"
                         % (channel, ", ".join(sorted(config["channels"]))))
    with open(STATE_FILE, "w") as f:
        f.write(channel + "\n")


def play(config, channel=None):
    set_channel(config, channel or current_channel(config))
    # enable so playback resumes after a power loss / reboot
    systemctl("enable", "--quiet", "sr-radio")
    systemctl("restart", "sr-radio")


def select(config, channel):
    set_channel(config, channel)
    if is_playing():
        systemctl("restart", "sr-radio")


def set_output(config, output):
    if output not in config["outputs"]:
        raise ValueError("unknown output: %s (available: %s)"
                         % (output, ", ".join(sorted(config["outputs"]))))
    with open(OUTPUT_FILE, "w") as f:
        f.write(output + "\n")
    if is_playing():
        systemctl("restart", "sr-radio")


def stop():
    systemctl("disable", "--quiet", "sr-radio")
    systemctl("stop", "sr-radio")


def status(config):
    return {"playing": is_playing(), "channel": current_channel(config),
            "output": current_output(config)}


def pactl_json(*args):
    out = subprocess.run(["pactl", "-f", "json", *args], check=False,
                         capture_output=True, text=True)
    try:
        return json.loads(out.stdout or "null") or []
    except ValueError:
        return []


def volume_percent(volume):
    for ch in volume.values():
        percent = str(ch.get("value_percent", "")).rstrip("%")
        try:
            return int(float(percent))
        except ValueError:
            continue
    return 0


def mixer_state(config):
    # label sinks with the configured output names where they match
    labels = {o["device"].split("/", 1)[-1]: o["name"]
              for o in config["outputs"].values() if o.get("device")}
    sinks = [{"id": s["name"],
              "name": labels.get(s["name"], s.get("description", s["name"])),
              "volume": volume_percent(s.get("volume", {}))}
             for s in pactl_json("list", "sinks")]
    streams = [{"id": si["index"],
                "name": si.get("properties", {}).get("application.name")
                or si.get("properties", {}).get("media.name")
                or "ström %s" % si["index"],
                "volume": volume_percent(si.get("volume", {}))}
               for si in pactl_json("list", "sink-inputs")]
    return {"sinks": sinks, "streams": streams}


def set_volume(kind, ident, volume):
    try:
        volume = max(0, min(100, int(volume)))
    except (TypeError, ValueError):
        raise ValueError("invalid volume")
    ident = str(ident)
    if not ident or ident.startswith("-"):
        raise ValueError("invalid id")
    commands = {"sink": "set-sink-volume", "stream": "set-sink-input-volume"}
    if kind not in commands:
        raise ValueError("invalid type: %s" % kind)
    subprocess.run(["pactl", commands[kind], ident, "%d%%" % volume], check=False)


def run_player(config):
    url = config["channels"][current_channel(config)]["url"]
    # live streams cannot buffer ahead of real time, so fast reconnect is the
    # only robustness lever: give up stalls quickly and let ffmpeg reconnect
    # transparently instead of exiting
    args = ["mpv", "--no-video", "--really-quiet",
            "--audio-client-name=SR Radio",
            "--network-timeout=10",
            "--stream-lavf-o=reconnect=1,reconnect_streamed=1"]
    device = config["outputs"][current_output(config)]["device"]
    if device:
        args.append("--audio-device=" + device)
    os.execvp("mpv", args + [url])


