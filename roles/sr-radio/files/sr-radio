"""


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, payload):
        body = (json.dumps(payload) + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        config = load_config()
        if self.path == "/":
            body = GUI_PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/status":
            self.reply(200, status(config))
        elif self.path == "/channels":
            self.reply(200, {"channels": [{"id": cid, "name": ch["name"]}
                                          for cid, ch in sorted(config["channels"].items())],
                             "default": config["default_channel"]})
        else:
            self.reply(404, {"error": "not found"})

    def body_channel(self, config):
        length = int(self.headers.get("Content-Length") or 0)
        if not length:
            return None
        body = json.loads(self.rfile.read(length))
        return body.get("channel")

    def do_POST(self):
        config = load_config()
        if self.path in ("/play", "/select"):
            try:
                channel = self.body_channel(config)
                if self.path == "/play":
                    play(config, channel)
                else:
                    select(config, channel or current_channel(config))
            except ValueError as e:
                return self.reply(400, {"error": str(e)})
            self.reply(200, status(config))
        elif self.path == "/stop":
            stop()
            self.reply(200, status(config))
        else:
            self.reply(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args), flush=True)


def main():
    config = load_config()
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "play":
        channel = sys.argv[2] if len(sys.argv) > 2 else None
        play(config, channel)
        print("playing %s" % current_channel(config))
    elif cmd == "stop":
        stop()
        print("stopped")
    elif cmd == "status":
        s = status(config)
        print("%s (%s)" % ("playing" if s["playing"] else "stopped", s["channel"]))
    elif cmd == "channels":
        for cid, ch in sorted(config["channels"].items()):
            print("%s\t%s" % (cid, ch["name"]))
    elif cmd == "serve":
        ThreadingHTTPServer(("0.0.0.0", config["port"]), Handler).serve_forever()
    elif cmd == "_run":
        run_player(config)
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except ValueError as e:
        print("error: %s" % e, file=sys.stderr)
        sys.exit(1)
